{
  "name": "ngrx-effects-cookbook",
  "version": "0.1.0",
  "description": "Production-shaped Angular NGRX Effects recipes for cancellation, concurrency, retries, polling, optimistic rollback, debounce, and progress streams.",
  "private": true,
  "license": "MIT",
  "author": "Mohamad Kayal",
  "keywords": [
    "angular",
    "ngrx",
    "ngrx-effects",
    "rxjs",
    "typescript",
    "state-management",
    "jest",
    "testing",
    "cookbook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamad-kayal/ngrx-effects-cookbook.git"
  },
  "bugs": {
    "url": "https://github.com/mohamad-kayal/ngrx-effects-cookbook/issues"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "start": "ng serve demo --host 0.0.0.0 --port 4200",
    "build": "ng build demo",
    "test": "jest --config jest.config.ts --runInBand",
    "lint": "eslint . --ext .ts,.html",
    "verify": "npm run lint && npm test && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@angular/animations": "21.2.10",
    "@angular/common": "21.2.10",
    "@angular/compiler": "21.2.10",
    "@angular/core": "21.2.10",
    "@angular/forms": "21.2.10",
    "@angular/platform-browser": "21.2.10",
    "@angular/platform-browser-dynamic": "21.2.10",
    "@angular/router": "21.2.10",
    "@ngrx/effects": "21.1.0",
    "@ngrx/operators": "21.1.0",
    "@ngrx/store": "21.1.0",
    "@ngrx/store-devtools": "21.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/build": "21.2.8",
    "@angular/cli": "21.2.8",
    "@angular/compiler-cli": "21.2.10",
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "8.57.1",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-marbles": "3.1.1",
    "jest-preset-angular": "16.1.4",
    "jsdom": "27.3.0",
    "prettier": "3.7.4",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
